    // Global Action Handlers (exposed on window for check_web_app.py verification)
    window.appActions = {
      startQuickPlay(withAutoplay = false) {
        appState.view = 'gameplay';
        if (engine) {
          engine.setAutoplayMode(Boolean(withAutoplay));
          engine.loadLevel(appState.currentLevel);
          engine.start();
        }
        renderUI();
      },
      openLevelSelect() {
        appState.view = 'level_select';
        if (engine) {
          engine.state = 'idle';
          rhythmAudio.stopMusic();
        }
        renderUI();
      },
      openGarage() {
        appState.view = 'garage';
        if (engine) {
          engine.state = 'idle';
          rhythmAudio.stopMusic();
        }
        renderUI();
      },
      backToTitle() {
        appState.view = 'title';
        if (engine) {
          engine.state = 'idle';
          rhythmAudio.stopMusic();
        }
        renderUI();
      },
      toggleHowTo(show) {
        appState.showHowTo = show !== undefined ? show : !appState.showHowTo;
        renderUI();
      },
      toggleMute() {
        rhythmAudio.toggleMute();
        renderUI();
      },
      launchLevel(levelId, withAutoplay = false) {
        const lvl = LEVELS.find((l) => l.id === levelId) || LEVELS[0];
        appState.currentLevel = lvl;
        appState.view = 'gameplay';
        if (engine) {
          engine.setAutoplayMode(Boolean(withAutoplay));
          engine.loadLevel(lvl);
          engine.start();
        }
        renderUI();
      },
      setGarageTab(tab) {
        appState.garageTab = tab;
        renderUI();
      },
      updateCustomization(field, value) {
        const nextCustom = { ...appState.profile.customization, [field]: value };
        appState.profile = { ...appState.profile, customization: nextCustom };
        savePlayerProfile(appState.profile);
        if (engine) engine.setCustomization(nextCustom);
        renderUI();
      },
      pauseGame() {
        if (engine) engine.togglePause();
        renderUI();
      },
      restartGame() {
        if (engine) {
          engine.attempts++;
          engine.restartLevel();
        }
        renderUI();
      },
      nextLevel() {
        const idx = LEVELS.findIndex((l) => l.id === appState.currentLevel.id);
        if (idx >= 0 && idx + 1 < LEVELS.length) {
          window.appActions.launchLevel(LEVELS[idx + 1].id, engine ? engine.isAutoplayMode : false);
        } else {
          window.appActions.openLevelSelect();
        }
      },
      togglePractice() {
        if (engine) {
          engine.setPracticeMode(!engine.isPracticeMode);
        }
        renderUI();
      },
      toggleAutoplay() {
        if (engine) {
          engine.setAutoplayMode(!engine.isAutoplayMode);
        }
        renderUI();
      },
      toggleTimeSlow() {
        if (engine) {
          engine.toggleTimeSlow();
        }
        updateHudDOM();
      },
      addCheckpoint() {
        if (engine) engine.addCheckpoint();
      },
      removeCheckpoint() {
        if (engine) engine.removeCheckpoint();
      },
      triggerPhaseShift() {
        if (engine) engine.triggerManualPhaseShift();
      },
      triggerJumpTap() {
        if (!engine) return;
        engine.triggerManualJumpDown();
        setTimeout(() => {
          if (engine) engine.triggerManualJumpUp();
        }, 130);
      },
    };

