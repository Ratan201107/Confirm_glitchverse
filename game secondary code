      const attemptEl = document.getElementById('hud-attempt');
      if (attemptEl) attemptEl.textContent = `ATTEMPT ${t.attempts}`;

      const scoreEl = document.getElementById('hud-score');
      if (scoreEl) scoreEl.textContent = `SCORE ${t.score.toLocaleString()}`;

      const pctEl = document.getElementById('hud-percent');
      if (pctEl) pctEl.textContent = `${t.percent}%`;

      const barEl = document.getElementById('hud-progress-bar');
      if (barEl) barEl.style.width = `${t.percent}%`;

      for (let i = 0; i < 3; i++) {
        const coinEl = document.getElementById(`hud-coin-${i}`);
        if (coinEl) {
          coinEl.className = t.coinsCollected[i]
            ? 'text-amber-400 drop-shadow-[0_0_6px_#ffaa00] text-sm'
