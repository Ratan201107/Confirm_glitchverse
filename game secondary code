                  <span class="text-[10px] text-zinc-400 block uppercase">TOTAL SCORE</span>
                  <span class="text-xl font-bold text-emerald-400 tabular-nums">${(vs.score || 0).toLocaleString()}</span>
                </div>
                <div>
                  <span class="text-[10px] text-zinc-400 block uppercase">ATTEMPTS</span>
                  <span class="text-xl font-bold text-white tabular-nums">${vs.attempts}</span>
                </div>
                <div>
                  <span class="text-[10px] text-zinc-400 block uppercase">TIME & COINS</span>
                  <div class="flex items-center gap-2">
                    <span class="text-base font-bold text-cyan-300 tabular-nums">${vs.time.toFixed(1)}s</span>
                    <div class="flex gap-1">
                      ${vs.coins
                        .map(
                          (c) =>
                            `<span class="text-base ${
                              c ? 'text-amber-400 drop-shadow-[0_0_6px_#ffaa00]' : 'text-zinc-700'
                            }">★</span>`
                        )
                        .join('')}
                    </div>
                  </div>
                </div>
              </div>

              <div class="w-full flex flex-col gap-2.5 font-mono">
                ${
                  hasNextLevel
                    ? `<button
                        onclick="window.appActions.nextLevel()"
                        class="w-full py-3 bg-gradient-to-r from-cyan-400 to-blue-500 hover:from-cyan-300 hover:to-blue-400 text-black font-bold text-sm uppercase tracking-wider rounded cursor-pointer transition-all shadow-[0_0_20px_rgba(0,240,255,0.5)]"
                      >
                        NEXT SECTOR →
                      </button>`
                    : ''
                }
                <button
                  onclick="window.appActions.restartGame()"
                  class="w-full py-2.5 bg-zinc-900 hover:bg-zinc-800 text-cyan-300 border border-cyan-500/40 font-semibold text-xs uppercase tracking-wider rounded cursor-pointer transition-all"
                >
                  ↻ PLAY AGAIN
                </button>
                <button
                  onclick="window.appActions.openLevelSelect()"
                  class="w-full py-2 text-zinc-400 hover:text-white text-xs uppercase tracking-wider rounded cursor-pointer transition-all"
                >
                  ❖ SECTOR SELECTION
                </button>
              </div>
            </div>
          </div>
        `;
      }

      root.innerHTML = `
        <div class="absolute inset-0 z-20 pointer-events-none select-none flex flex-col justify-between p-4 sm:p-6 overflow-hidden">
          <!-- TOP PERIMETER HUD STRIP -->
          <div class="flex flex-wrap items-center justify-between gap-3 w-full">
            <!-- Left: Level Info, Attempts & Score -->
            <div class="flex items-center gap-3 bg-black/75 border border-cyan-900/60 px-3.5 py-1.5 rounded pointer-events-auto">
              <div>
                <span class="text-[10px] uppercase font-mono tracking-wider text-cyan-400/90 block">${appState.currentLevel.title}</span>
                <div class="flex items-center gap-3">
                  <span id="hud-attempt" class="text-xs font-mono font-bold text-white tabular-nums">ATTEMPT ${t.attempts}</span>
                  <span id="hud-score" class="text-xs font-mono font-bold text-emerald-400 tabular-nums">SCORE ${t.score.toLocaleString()}</span>
                </div>
              </div>
              <div class="flex items-center gap-1 pl-2 border-l border-zinc-800">
                <span id="hud-coin-0" class="text-zinc-700 text-sm">★</span>
                <span id="hud-coin-1" class="text-zinc-700 text-sm">★</span>
                <span id="hud-coin-2" class="text-zinc-700 text-sm">★</span>
              </div>
            </div>

            <!-- Center: Live Progress Bar -->
            <div class="flex-1 min-w-[160px] max-w-md mx-2 flex flex-col items-center">
              <div class="w-full flex justify-between items-center text-[11px] font-mono mb-1">
                <span class="text-zinc-400">SECTOR PROGRESS</span>
                <span id="hud-percent" class="text-cyan-300 font-bold tabular-nums">${t.percent}%</span>
              </div>
              <div class="w-full h-2.5 bg-black/80 rounded-full overflow-hidden border border-cyan-900/60">
                <div id="hud-progress-bar" class="h-full bg-gradient-to-r from-cyan-400 via-blue-500 to-fuchsia-500 rounded-full transition-all duration-75" style="width:${t.percent}%"></div>
              </div>
            </div>

            <!-- Right: Separated Abilities, Autoplay, Mute & Pause -->
            <div class="flex flex-wrap items-center gap-2 pointer-events-auto">
              <!-- Ability 1: Phase Shift [Shift / F] -->
              <button
                id="hud-phase-btn"
                onclick="window.appActions.triggerPhaseShift()"
                class="px-3 py-1.5 rounded border font-mono text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 transition-colors cursor-pointer bg-cyan-950/80 border-cyan-400 text-cyan-300"
                title="Toggle Dimension Phase [Shift or F]"
              >
                <span id="hud-phase-dot" class="w-2 h-2 rounded-full bg-cyan-400"></span>
                <span id="hud-phase-text">CYAN [SHIFT / F]</span>
              </button>

              <!-- Ability 2: Time Dilation Slowdown [E / S / Down] -->
              <button
                id="hud-slow-btn"
                onclick="window.appActions.toggleTimeSlow()"
                class="px-3 py-1.5 rounded border font-mono text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 cursor-pointer bg-sky-950/70 border-sky-500/40 text-sky-300"
                title="Time Dilation 0.5x Slowdown [Hold E / S / Down or Click]"
              >
                <span>⏱ 0.5X SLOW [E]</span>
              </button>

              <!-- Autoplay Mode Toggle [A] -->
              <button
                id="hud-auto-btn"
                onclick="window.appActions.toggleAutoplay()"
                class="px-3 py-1.5 rounded border font-mono text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 cursor-pointer bg-zinc-900/80 border-amber-500/40 text-amber-300"
                title="Toggle AI Autoplay Pilot [A]"
              >
                ${t.isAutoplay ? 'AUTOPLAY: ON [A]' : 'AUTOPLAY: OFF [A]'}
              </button>

              <button
                onclick="window.appActions.toggleMute()"
                class="p-2 bg-black/75 hover:bg-black/90 text-cyan-400 border border-cyan-900/60 rounded cursor-pointer"
                title="${muted ? 'Unmute' : 'Mute'}"
              >
                ${muteIcon}
              </button>

              <button
                onclick="window.appActions.pauseGame()"
                class="p-2 bg-black/75 hover:bg-black/90 text-cyan-400 border border-cyan-900/60 rounded cursor-pointer font-mono text-xs font-bold px-2.5"
                title="Pause Game [Esc]"
              >
                ❚❚
              </button>
            </div>
          </div>

          <!-- PRACTICE MODE FLOATING DOCK -->
          <div
            id="hud-practice-dock"
            style="display:${t.isPractice ? 'flex' : 'none'}"
            class="pointer-events-auto self-center items-center gap-3 bg-black/85 border border-emerald-500/40 px-4 py-2 rounded-lg shadow-lg mb-2"
          >
            <button
              onclick="window.appActions.addCheckpoint()"
              class="flex items-center gap-1.5 px-3 py-1 bg-emerald-500/20 hover:bg-emerald-500/40 text-emerald-300 border border-emerald-500/50 rounded font-mono text-xs font-bold uppercase cursor-pointer"
            >
              <span>+ DROP CHECKPOINT [Z]</span>
            </button>
            <button
              onclick="window.appActions.removeCheckpoint()"
              class="flex items-center gap-1.5 px-3 py-1 bg-red-500/20 hover:bg-red-500/40 text-red-300 border border-red-500/50 rounded font-mono text-xs font-bold uppercase cursor-pointer"
            >
              <span>- REMOVE [X]</span>
            </button>
          </div>

          <!-- ON-SCREEN TOUCH & MOUSE CONTROLS (SEPARATED ABILITIES!) -->
          <div class="flex items-end justify-between w-full pointer-events-auto gap-3">
            <div class="flex flex-wrap items-center gap-2.5">
              <button
                onclick="window.appActions.triggerPhaseShift()"
                class="px-5 py-4 bg-fuchsia-950/85 hover:bg-fuchsia-900 active:bg-fuchsia-600 border border-fuchsia-500/60 text-fuchsia-200 font-mono text-xs font-bold uppercase tracking-wider rounded-lg cursor-pointer transition-all active:scale-95 shadow-md"
              >
                ⚡ PHASE SHIFT [SHIFT / F]
              </button>

              <button
                onclick="window.appActions.toggleTimeSlow()"
                class="px-5 py-4 bg-sky-950/85 hover:bg-sky-900 active:bg-sky-600 border border-sky-500/60 text-sky-200 font-mono text-xs font-bold uppercase tracking-wider rounded-lg cursor-pointer transition-all active:scale-95 shadow-md"
              >
                ⏱ TIME SLOW [E / S]
              </button>
            </div>

            <button
              onclick="window.appActions.triggerJumpTap()"
              class="px-8 py-5 bg-cyan-950/85 hover:bg-cyan-900 active:bg-cyan-500 border border-cyan-400/60 text-cyan-200 active:text-black font-mono text-sm font-bold uppercase tracking-widest rounded-lg cursor-pointer transition-all active:scale-95 shadow-md"
            >
              ▲ JUMP / FLY [SPACE]
            </button>
          </div>
        </div>
        ${modalHtml}
      `;
      updateHudDOM();
    }

    // =========================================================================
    // 7. BOOTSTRAP ON WINDOW LOAD
    // =========================================================================
    window.addEventListener('load', () => {
      const mount = document.getElementById('canvas-mount');
      engine = new GlitchPulseEngine(
        mount,
        appState.currentLevel,
        appState.profile.customization,
        {
          onTelemetry: (t) => {
            appState.telemetry = t;
            updateHudDOM();

            // Persist best progress percentage to the ACTIVE level (fixing stale closure bug!)
            const lvlId = engine ? engine.currentLevel.id : appState.currentLevel.id;
            const currentBest = appState.profile.levels[lvlId]?.bestPercent || 0;
            if (t.percent > currentBest) {
              appState.profile.levels[lvlId] = {
                ...appState.profile.levels[lvlId],
                bestPercent: t.percent,
                attempts: Math.max(appState.profile.levels[lvlId]?.attempts || 0, t.attempts),
              };
              savePlayerProfile(appState.profile);
            }
          },
          onStateChange: (newState) => {
            const prevState = appState.engineState;
            appState.engineState = newState;
            if (prevState !== newState && (newState === 'paused' || newState === 'victory' || prevState === 'paused' || prevState === 'victory')) {
              renderUI();
            }
          },
          onVictory: (stats) => {
            appState.victoryStats = stats;
            const lvlId = stats.level.id;
            const currentLvl = appState.profile.levels[lvlId] || {
              completed: false,
              bestPercent: 0,
              attempts: 0,
              coins: [false, false, false],
              bestTime: 0,
              bestScore: 0,
            };

            const mergedCoins = [
              Boolean(currentLvl.coins[0] || stats.coins[0]),
              Boolean(currentLvl.coins[1] || stats.coins[1]),
              Boolean(currentLvl.coins[2] || stats.coins[2]),
            ];

            const newlyCompleted = !currentLvl.completed;
            appState.profile = {
              ...appState.profile,
              starsCollected: appState.profile.starsCollected + (newlyCompleted ? stats.level.stars : 0),
              levels: {
                ...appState.profile.levels,
                [lvlId]: {
                  completed: true,
                  bestPercent: 100,
                  attempts: stats.attempts,
                  coins: mergedCoins,
                  bestTime: currentLvl.bestTime > 0 ? Math.min(currentLvl.bestTime, stats.time) : stats.time,
                  bestScore: Math.max(currentLvl.bestScore || 0, stats.score || 0),
                },
              },
            };
            savePlayerProfile(appState.profile);
            renderUI();
          },
        }
      );

      renderUI();
    });
  </script>
</body>
</html>
