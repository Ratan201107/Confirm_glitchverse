        }
      }

      const phaseBadge = document.getElementById('hud-phase-btn');
      const phaseDot = document.getElementById('hud-phase-dot');
      const phaseText = document.getElementById('hud-phase-text');
      if (phaseBadge && phaseDot && phaseText) {
