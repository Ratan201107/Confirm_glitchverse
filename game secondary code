    function checkAABB(a, b) {
      return a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y;
    }

    function checkSpikeCollision(playerBox, spike) {
      const inset = 5;
      const spikeBox = {
        x: spike.x + inset,
        y: spike.y + (spike.spikeDir === 'down' ? 0 : inset),
        w: spike.w - inset * 2,
        h: spike.h - inset,
      };
      return checkAABB(playerBox, spikeBox);
    }

    function checkBlockCollision(playerBox, block, gravityDir) {
      if (!checkAABB(playerBox, block)) return 'none';
      const feetY = gravityDir === 1 ? playerBox.y : playerBox.y + playerBox.h;
      const blockTopY = block.y + block.h;
      const blockBottomY = block.y;

      if (gravityDir === 1) {
        if (feetY >= blockTopY - 16) return 'top';
        if (playerBox.y + playerBox.h <= blockBottomY + 12) return 'head';
      } else {
        if (feetY <= blockBottomY + 16) return 'bottom';
        if (playerBox.y >= blockTopY - 12) return 'head';
      }
      return 'side';
    }

    // Intelligent Autoplay AI Pilot (verified 100% completion + all 3 coins across all 4 levels)
    function computeAutoplayInputs(player, level) {
      let jumpHeld = false;
      let jumpJustPressed = false;
      let phaseJustPressed = false;
      let timeSlowHeld = false;

      const px = player.x;
      const py = player.y;
      const pRight = px + PLAYER_SIZE;
      const objs = level.objects;

      // 1. Phase Shift Management: inspect upcoming phased obstacles within 150px
      for (const obj of objs) {
        if (obj.x + obj.w < px || obj.x > px + 150) continue;
        if (!obj.phase || obj.phase === 'none' || obj.type === 'portal_phase') continue;

        if (obj.type === 'spike') {
          if (obj.phase === player.phase) {
            phaseJustPressed = true;
            break;
          }
        } else if (obj.type === 'block') {
          if (obj.h >= 100 && obj.phase === player.phase) {
            phaseJustPressed = true;
            break;
          }
          if (obj.h < 100 && obj.phase !== player.phase) {
            phaseJustPressed = true;
            break;
          }
        }
      }

      // 2. Time Dilation Showcase in Level 3 & Level 4 rapid sections
      if (
        (level.id === 3 && px >= 2100 && px <= 2400) ||
        (level.id === 4 && px >= 5500 && px <= 6100)
      ) {
        timeSlowHeld = true;
      }

      // 3. Vehicle Mode Steering
      if (player.vehicleMode === 'cube') {
        for (const obj of objs) {
          if (obj.type === 'jump_ring' && !obj.activated) {
            const dist = Math.hypot(
              obj.x + obj.w / 2 - (px + PLAYER_SIZE / 2),
              obj.y + obj.h / 2 - (py + PLAYER_SIZE / 2)
            );
            if (dist <= 48) {
              jumpJustPressed = true;
              jumpHeld = true;
              return { jumpHeld, jumpJustPressed, phaseJustPressed, timeSlowHeld };
            }
          }
        }

        if (player.isGrounded) {
          const lookahead = level.baseSpeed * (player.speedMultiplier || 1) * 0.25;
          for (const obj of objs) {
            const distX = obj.x - pRight;
            if (distX < -10 || distX > lookahead) continue;

            const isIntangible = obj.phase && obj.phase !== 'none' && obj.phase !== player.phase;
            if (isIntangible) continue;

            if (obj.type === 'spike') {
              if (player.gravityDir === 1 && Math.abs(obj.y - py) < 55) {
                if (distX <= 95) {
                  jumpJustPressed = true;
                  jumpHeld = true;
                  break;
                }
              } else if (player.gravityDir === -1 && Math.abs(obj.y + obj.h - (py + PLAYER_SIZE)) < 55) {
                if (distX <= 95) {
                  jumpJustPressed = true;
                  jumpHeld = true;
                  break;
                }
              }
            } else if (obj.type === 'block') {
              if (player.gravityDir === 1) {
                const stepHeight = obj.y + obj.h - py;
                if (stepHeight > 5 && stepHeight <= 115 && distX <= 95) {
                  jumpJustPressed = true;
                  jumpHeld = true;
                  break;
                }
              } else {
                const stepDepth = py + PLAYER_SIZE - obj.y;
                if (stepDepth > 5 && stepDepth <= 115 && distX <= 95) {
                  jumpJustPressed = true;
                  jumpHeld = true;
                  break;
                }
              }
            } else if (obj.type === 'coin' && !obj.activated) {
              if (
                player.gravityDir === 1 &&
                obj.y > py + 25 &&
                obj.y < py + 155 &&
                distX <= 80 &&
                distX >= 5
              ) {
                jumpJustPressed = true;
                jumpHeld = true;
                break;
              } else if (
                player.gravityDir === -1 &&
                py + PLAYER_SIZE - (obj.y + obj.h) > 25 &&
                py + PLAYER_SIZE - (obj.y + obj.h) < 155 &&
                distX <= 80 &&
                distX >= 5
              ) {
                jumpJustPressed = true;
                jumpHeld = true;
                break;
              }
            }
          }
        }
      } else if (player.vehicleMode === 'glider' || player.vehicleMode === 'wave') {
        let targetY = level.ceilingY / 2 - PLAYER_SIZE / 2;
        const lookWindow = 320;

        for (const obj of objs) {
          if (obj.x + obj.w < px || obj.x > px + lookWindow) continue;
          const isIntangible = obj.phase && obj.phase !== 'none' && obj.phase !== player.phase;
          if (isIntangible) continue;

          if (obj.type === 'spike' || obj.type === 'block') {
            const objCenterY = obj.y + obj.h / 2;
            if (objCenterY < level.ceilingY / 2) {
              const safeLow = obj.y + obj.h + 75;
              targetY = Math.max(targetY, Math.min(level.ceilingY - PLAYER_SIZE - 50, safeLow));
            } else {
              const safeHigh = obj.y - PLAYER_SIZE - 75;
              targetY = Math.min(targetY, Math.max(50, safeHigh));
            }
            break;
          } else if (obj.type === 'coin' && !obj.activated && obj.x - px < 180) {
            targetY = obj.y;
          }
        }

        if (player.gravityDir === 1) {
          if (player.vehicleMode === 'glider') {
            jumpHeld = py + player.vy * 0.12 < targetY;
          } else {
            jumpHeld = py < targetY - 6;
          }
        } else {
          if (player.vehicleMode === 'glider') {
            jumpHeld = py + player.vy * 0.12 > targetY;
          } else {
            jumpHeld = py > targetY + 6;
          }
        }
      }

      return { jumpHeld, jumpJustPressed, phaseJustPressed, timeSlowHeld };
    }

    // =========================================================================
    // 5. MAIN 60FPS CANVAS GAME ENGINE & MULTI-LAYER CYBERPUNK RENDERER
    // =========================================================================
    class GlitchPulseEngine {
      constructor(container, level, customization, callbacks) {
        this.container = container;
        this.currentLevel = level;
        this.customization = customization;
        this.onTelemetry = callbacks.onTelemetry;
        this.onStateChange = callbacks.onStateChange;
        this.onVictory = callbacks.onVictory;

        this.state = 'idle';
        this.isPracticeMode = false;
        this.isAutoplayMode = false;
        this.attempts = 1;
        this.coinsCollected = [false, false, false];
        this.score = 0;
        this.combo = 1;
        this.elapsedTime = 0;
        this.startX = 150;

        this.checkpoints = [];
        this.particles = [];
        this.shockwaves = [];
        this.trailNodes = [];
        this.cameraX = 0;
        this.screenShake = 0;
        this.bgTime = 0;

        // Starfield for multi-layer background
        this.stars = Array.from({ length: 70 }, (_, i) => ({
          x: (i * 173.7) % 1920,
          y: (i * 97.3) % 700,
          size: (i % 3) + 1,
          speed: 0.02 + (i % 4) * 0.015,
          twinklePhase: i * 0.8,
        }));

        // Separate, non-colliding keystates for Jump, Phase Shift, and Time Dilation!
        // Plus waitForJumpRelease to prevent jumping on restart/launch!
        this.keyState = {
          jumpHeld: false,
          jumpJustPressed: false,
          waitForJumpRelease: false,
          phaseJustPressed: false,
          phaseKeyDown: false,
          timeSlowHeld: false,
          timeSlowToggled: false,
        };
        this.spawnGraceTimer = 0;

        this.frameCount = 0;
        this.fpsTimer = 0;
        this.currentFps = 60;

        this.canvas = document.createElement('canvas');
        this.ctx = this.canvas.getContext('2d', { alpha: false });
        this.container.appendChild(this.canvas);

        this.player = this.createDefaultPlayer();
        this.handleResize();
        this.bindEvents();

        this.tick = this.tick.bind(this);
        this.lastTime = performance.now();
        this.animId = requestAnimationFrame(this.tick);
      }

      createDefaultPlayer() {
        return {
          x: this.startX,
          y: 0,
          vy: 0,
          rotation: 0,
          isGrounded: true,
          gravityDir: 1,
          vehicleMode: 'cube',
          phase: 'cyan',
          isTimeDilated: false,
          speedMultiplier: 1.0,
          coyoteTimer: 0,
          jumpBufferTimer: 0,
          jumpKeyHeld: false,
          jumpJustPressed: false,
          phaseJustPressed: false,
        };
      }

      loadLevel(level) {
        this.currentLevel = level;
        this.checkpoints = [];
        this.coinsCollected = [false, false, false];
        this.attempts = 1;
        this.restartLevel();
      }

      setCustomization(custom) {
        this.customization = custom;
      }

      start() {
        rhythmAudio.ensureContext();
        this.restartLevel();
      }

      restartLevel() {
        rhythmAudio.stopMusic();

        // CRITICAL FIX: Reset all jump/input buffers & require fresh release so the
        // player NEVER auto-jumps on restart or when clicking UI buttons!
        this.keyState.jumpJustPressed = false;
        this.keyState.phaseJustPressed = false;
        if (this.keyState.jumpHeld) {
          this.keyState.waitForJumpRelease = true;
        }
        this.keyState.jumpHeld = false;
        this.spawnGraceTimer = 0.14;

        if (this.isPracticeMode && this.checkpoints.length > 0) {
          const cp = this.checkpoints[this.checkpoints.length - 1];
          this.player = {
            ...this.createDefaultPlayer(),
            x: cp.x,
            y: cp.y,
            vy: cp.vy,
            rotation: cp.rotation,
            gravityDir: cp.gravityDir,
            vehicleMode: cp.vehicleMode,
            phase: cp.phase,
            speedMultiplier: cp.speedMultiplier,
            isGrounded: cp.isGrounded,
          };
          // Re-enable objects ahead of checkpoint
          this.currentLevel.objects.forEach((obj) => {
            if (obj.x >= cp.x - 40 && obj.type !== 'coin') {
              obj.activated = false;
            }
          });
        } else {
          this.player = this.createDefaultPlayer();
          this.coinsCollected = [false, false, false];
          this.score = 0;
          this.combo = 1;
          this.elapsedTime = 0;
          this.currentLevel.objects.forEach((obj) => {
            obj.activated = false;
          });
        }

        this.particles = [];
        this.shockwaves = [];
        this.trailNodes = [];
        this.screenShake = 0;
        this.state = 'playing';

        rhythmAudio.startMusic(this.currentLevel.id, this.currentLevel.bpm);
        if (this.onStateChange) this.onStateChange('playing');
      }

      setPracticeMode(enabled) {
        this.isPracticeMode = enabled;
        if (!enabled) {
          this.checkpoints = [];
        }
        this.emitTelemetry();
      }

      setAutoplayMode(enabled) {
        this.isAutoplayMode = enabled;
        this.keyState.jumpHeld = false;
        this.keyState.jumpJustPressed = false;
        this.keyState.phaseJustPressed = false;
        this.emitTelemetry();
      }

      toggleTimeSlow() {
        this.keyState.timeSlowToggled = !this.keyState.timeSlowToggled;
        this.emitTelemetry();
      }

      triggerManualPhaseShift() {
        if (this.state !== 'playing') return;
        this.keyState.phaseJustPressed = true;
      }

      triggerManualJumpDown() {
        if (this.state === 'crashed') {
          this.attempts++;
          this.restartLevel();
          return;
        }
        if (this.state !== 'playing') return;
        this.keyState.waitForJumpRelease = false;
        this.keyState.jumpJustPressed = true;
        this.keyState.jumpHeld = true;
      }

      triggerManualJumpUp() {
        this.keyState.jumpHeld = false;
        this.keyState.waitForJumpRelease = false;
      }

      addCheckpoint() {
        if (!this.isPracticeMode || this.state !== 'playing') return;
        this.checkpoints.push({
          x: this.player.x,
          y: this.player.y,
          vy: this.player.vy,
          rotation: this.player.rotation,
          gravityDir: this.player.gravityDir,
          vehicleMode: this.player.vehicleMode,
          phase: this.player.phase,
          speedMultiplier: this.player.speedMultiplier,
          isGrounded: this.player.isGrounded,
        });
        rhythmAudio.playCheckpoint();
      }

      removeCheckpoint() {
        if (!this.isPracticeMode) return;
        if (this.checkpoints.length > 0) {
          this.checkpoints.pop();
          rhythmAudio.playCheckpoint();
        }
      }

      togglePause() {
        if (this.state === 'playing') {
          this.state = 'paused';
          rhythmAudio.stopMusic();
          if (this.onStateChange) this.onStateChange('paused');
        } else if (this.state === 'paused') {
          this.keyState.jumpHeld = false;
          this.keyState.jumpJustPressed = false;
          this.keyState.waitForJumpRelease = true;
          this.state = 'playing';
          rhythmAudio.startMusic(this.currentLevel.id, this.currentLevel.bpm);
          if (this.onStateChange) this.onStateChange('playing');
        }
      }

      bindEvents() {
        const onKeyDown = (e) => {
          const code = e.code.toLowerCase();

          // Ignore gameplay hotkeys when not in active gameplay views
          if (this.state === 'idle' || this.state === 'victory') return;

          // Pause toggle
          if (code === 'escape' || code === 'keyp') {
            e.preventDefault();
            this.togglePause();
            return;
          }

          // Quick Restart
          if (code === 'keyr') {
            e.preventDefault();
            this.attempts++;
            this.restartLevel();
            return;
          }

          // Autoplay Mode Toggle [A]
          if (code === 'keya') {
            e.preventDefault();
            this.setAutoplayMode(!this.isAutoplayMode);
            return;
          }

          if (this.state === 'paused') {
            if (code === 'space') {
              e.preventDefault();
              this.togglePause();
            }
            return;
          }

          // Jump / Fly / Wave: Space, ArrowUp, KeyW
          if (code === 'space' || code === 'arrowup' || code === 'keyw') {
            e.preventDefault();
            if (this.state === 'crashed') {
              // Restart cleanly WITHOUT queuing a jump!
              this.keyState.waitForJumpRelease = true;
              this.keyState.jumpHeld = false;
              this.keyState.jumpJustPressed = false;
              this.attempts++;
              this.restartLevel();
              return;
            }
            if (this.keyState.waitForJumpRelease) return;
            if (!this.keyState.jumpHeld) {
              this.keyState.jumpJustPressed = true;
            }
            this.keyState.jumpHeld = true;
          }

          // ABILITY 1 (SEPARATED): Dimension Phase Shift (Cyan <-> Magenta) -> Shift or F
          if (code === 'shiftleft' || code === 'shiftright' || code === 'keyf') {
            e.preventDefault();
            if (!this.keyState.phaseKeyDown) {
              this.keyState.phaseJustPressed = true;
              this.keyState.phaseKeyDown = true;
            }
          }

          // ABILITY 2 (SEPARATED): Time Dilation Slowdown (0.5x Chrono-Slow) -> E, C, S, ArrowDown
          if (code === 'keye' || code === 'keyc' || code === 'keys' || code === 'arrowdown') {
            e.preventDefault();
            this.keyState.timeSlowHeld = true;
          }

          // Practice Mode Checkpoints
          if (code === 'keyz') {
            this.addCheckpoint();
          }
          if (code === 'keyx') {
            this.removeCheckpoint();
          }
        };

        const onKeyUp = (e) => {
          const code = e.code.toLowerCase();
          if (code === 'space' || code === 'arrowup' || code === 'keyw') {
            this.keyState.jumpHeld = false;
            this.keyState.waitForJumpRelease = false;
          }
          if (code === 'shiftleft' || code === 'shiftright' || code === 'keyf') {
            this.keyState.phaseKeyDown = false;
          }
          if (code === 'keye' || code === 'keyc' || code === 'keys' || code === 'arrowdown') {
            this.keyState.timeSlowHeld = false;
          }
        };

        const isUIElement = (target) => {
          return target && target.closest && target.closest('button, a, input, [data-ui-interactive="true"]');
        };

        const onMouseDown = (e) => {
          // Never trigger jump when clicking a UI button or modal!
          if (isUIElement(e.target)) return;
          if (this.state !== 'playing' && this.state !== 'crashed') return;

          if (e.button === 0) {
            if (this.state === 'crashed') {
              this.keyState.waitForJumpRelease = true;
              this.keyState.jumpHeld = false;
              this.keyState.jumpJustPressed = false;
              this.attempts++;
              this.restartLevel();
              return;
            }
            if (this.keyState.waitForJumpRelease) return;
            if (!this.keyState.jumpHeld) this.keyState.jumpJustPressed = true;
            this.keyState.jumpHeld = true;
          } else if (e.button === 2) {
            // Right click triggers Dimension Phase Shift
            this.keyState.phaseJustPressed = true;
          }
        };

        const onMouseUp = (e) => {
          if (e.button === 0) {
            this.keyState.jumpHeld = false;
            this.keyState.waitForJumpRelease = false;
          }
        };

        const onContextMenu = (e) => e.preventDefault();

        const onTouchStart = (e) => {
          if (isUIElement(e.target)) return;
          if (this.state !== 'playing' && this.state !== 'crashed') return;

          if (this.state === 'crashed') {
            this.keyState.waitForJumpRelease = true;
            this.keyState.jumpHeld = false;
            this.keyState.jumpJustPressed = false;
            this.attempts++;
            this.restartLevel();
            return;
          }
          if (this.keyState.waitForJumpRelease) return;
          if (!this.keyState.jumpHeld) this.keyState.jumpJustPressed = true;
          this.keyState.jumpHeld = true;
        };

        const onTouchEnd = () => {
          this.keyState.jumpHeld = false;
          this.keyState.waitForJumpRelease = false;
        };

        const onBlur = () => {
          this.keyState.jumpHeld = false;
          this.keyState.jumpJustPressed = false;
          this.keyState.waitForJumpRelease = false;
          this.keyState.phaseJustPressed = false;
          this.keyState.phaseKeyDown = false;
          this.keyState.timeSlowHeld = false;
        };

        window.addEventListener('keydown', onKeyDown);
        window.addEventListener('keyup', onKeyUp);
        window.addEventListener('mousedown', onMouseDown);
        window.addEventListener('mouseup', onMouseUp);
        window.addEventListener('contextmenu', onContextMenu);
        window.addEventListener('touchstart', onTouchStart, { passive: true });
        window.addEventListener('touchend', onTouchEnd, { passive: true });
        window.addEventListener('blur', onBlur);
        window.addEventListener('resize', () => this.handleResize());
      }

      handleResize() {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const width = this.container.clientWidth || window.innerWidth;
        const height = this.container.clientHeight || window.innerHeight;
        this.canvas.width = width * dpr;
        this.canvas.height = height * dpr;
        this.canvas.style.width = width + 'px';
        this.canvas.style.height = height + 'px';
        this.ctx.setTransform(1, 0, 0, 1, 0, 0);
        this.ctx.scale(dpr, dpr);
      }

      emitTelemetry() {
        if (!this.onTelemetry) return;
        const progressPercent = Math.min(
          100,
          Math.max(0, Math.round((this.player.x / this.currentLevel.length) * 100))
        );
        this.onTelemetry({
          percent: progressPercent,
          attempts: this.attempts,
          coinsCollected: [...this.coinsCollected],
          isPractice: this.isPracticeMode,
          isAutoplay: this.isAutoplayMode,
          activePhase: this.player.phase,
          isTimeDilated: this.player.isTimeDilated,
          vehicleMode: this.player.vehicleMode,
          score: Math.floor(this.score),
          fps: this.currentFps,
        });
      }

      tick(now) {
        this.animId = requestAnimationFrame(this.tick);

        const rawDt = Math.min((now - this.lastTime) / 1000, 0.05);
        this.lastTime = now;
        this.bgTime += rawDt;

        this.frameCount++;
        this.fpsTimer += rawDt;
        if (this.fpsTimer >= 0.5) {
          this.currentFps = Math.round(this.frameCount / this.fpsTimer);
          this.frameCount = 0;
          this.fpsTimer = 0;
        }

        if (this.spawnGraceTimer > 0) {
          this.spawnGraceTimer = Math.max(0, this.spawnGraceTimer - rawDt);
        }

        // Determine Time Dilation state (from dedicated E/S/C key or HUD toggle or Autoplay)
        let isDilated = this.keyState.timeSlowHeld || this.keyState.timeSlowToggled;
        if (this.isAutoplayMode && this.state === 'playing') {
          const aiPreview = computeAutoplayInputs(this.player, this.currentLevel);
          if (aiPreview.timeSlowHeld) isDilated = true;
        }
        this.player.isTimeDilated = isDilated;
        rhythmAudio.setTimeDilation(isDilated);

        const effectiveDt = isDilated ? rawDt * 0.52 : rawDt;

        if (this.state === 'playing') {
          this.elapsedTime += rawDt;
          this.updatePhysics(effectiveDt);
        }

        this.updateVFX(rawDt);
        this.render();

        this.keyState.jumpJustPressed = false;
        this.keyState.phaseJustPressed = false;

        this.emitTelemetry();
      }

      updatePhysics(dt) {
        const level = this.currentLevel;
        const objects = level.objects;
        const levelCeilingY = level.ceilingY;

        // Sub-stepping with synchronized X and Y integration for framerate-independent precision
        const subSteps = Math.max(1, Math.min(8, Math.ceil(dt / 0.006)));
        const subDt = dt / subSteps;

        // Manual inputs (if not overridden by Autoplay)
        if (!this.isAutoplayMode) {
          const allowJump = this.spawnGraceTimer <= 0 && !this.keyState.waitForJumpRelease;
          this.player.jumpKeyHeld = allowJump ? this.keyState.jumpHeld : false;
          this.player.jumpJustPressed = allowJump ? this.keyState.jumpJustPressed : false;
          this.player.phaseJustPressed = this.keyState.phaseJustPressed;
        }

        for (let step = 0; step < subSteps; step++) {
          const speed = level.baseSpeed * (this.player.speedMultiplier || 1);
          this.player.x += speed * subDt;
          this.score += speed * subDt * 0.25 * this.combo;

          if (this.isAutoplayMode) {
            const ai = computeAutoplayInputs(this.player, level);
            this.player.jumpKeyHeld = ai.jumpHeld;
            if (ai.jumpJustPressed) this.player.jumpJustPressed = true;
            if (ai.phaseJustPressed) this.player.phaseJustPressed = true;
          }

          // 1. Process Phase Shift (strictly once per press!)
          if (this.player.phaseJustPressed) {
            this.player.phase = this.player.phase === 'cyan' ? 'magenta' : 'cyan';
            this.player.phaseJustPressed = false;
            rhythmAudio.playPhaseShift();
            this.screenShake = 5;
            this.score += 50;
            this.spawnPhaseShimmerParticles();
          }

          // 2. Vehicle Kinematics
          if (this.player.vehicleMode === 'cube') {
            if (this.player.isGrounded) {
              this.player.coyoteTimer = 0.08;
            } else {
              this.player.coyoteTimer = Math.max(0, this.player.coyoteTimer - subDt);
            }

            if (this.player.jumpJustPressed) {
              this.player.jumpBufferTimer = 0.12;
              this.player.jumpJustPressed = false;
            } else {
              this.player.jumpBufferTimer = Math.max(0, this.player.jumpBufferTimer - subDt);
            }

            if (
              (this.player.jumpBufferTimer > 0 || this.player.jumpKeyHeld) &&
              (this.player.isGrounded || this.player.coyoteTimer > 0)
            ) {
              this.player.vy = CUBE_JUMP_IMPULSE * this.player.gravityDir;
              this.player.isGrounded = false;
              this.player.coyoteTimer = 0;
              this.player.jumpBufferTimer = 0;
              rhythmAudio.playJump();
              this.spawnSparks(this.player.x + PLAYER_SIZE / 2, this.player.y, 6, this.customization.primaryColor);
            }

            this.player.vy -= CUBE_GRAVITY * this.player.gravityDir * subDt;
            this.player.y += this.player.vy * subDt;

            if (!this.player.isGrounded) {
              const rotSpeed = 460 * this.player.gravityDir;
              this.player.rotation = (this.player.rotation + rotSpeed * subDt) % 360;
            } else {
              this.player.rotation = Math.round(this.player.rotation / 90) * 90;
            }
          } else if (this.player.vehicleMode === 'glider') {
            if (this.player.jumpKeyHeld) {
              this.player.vy += GLIDER_THRUST * this.player.gravityDir * subDt;
            } else {
              this.player.vy -= GLIDER_GRAVITY * this.player.gravityDir * subDt;
            }
            const maxVy = 420;
            this.player.vy = Math.max(-maxVy, Math.min(maxVy, this.player.vy));
            this.player.y += this.player.vy * subDt;

            const targetAngle = (this.player.vy / maxVy) * 35 * this.player.gravityDir;
            this.player.rotation += (targetAngle - this.player.rotation) * Math.min(1.0, 15 * subDt);
          } else if (this.player.vehicleMode === 'wave') {
            if (this.player.jumpKeyHeld) {
              this.player.vy = WAVE_SPEED_Y * this.player.gravityDir;
              this.player.rotation = -45 * this.player.gravityDir;
            } else {
              this.player.vy = -WAVE_SPEED_Y * this.player.gravityDir;
              this.player.rotation = 45 * this.player.gravityDir;
            }
            this.player.y += this.player.vy * subDt;
          }

          // 3. Floor & Ceiling Boundaries
          const minY = 0;
          const maxY = levelCeilingY - PLAYER_SIZE;
          let onBoundary = false;

          if (this.player.gravityDir === 1) {
            if (this.player.y <= minY) {
              this.player.y = minY;
              this.player.vy = 0;
              onBoundary = true;
            }
            if (this.player.y >= maxY) {
              this.player.y = maxY;
              this.player.vy = 0;
            }
          } else {
            if (this.player.y >= maxY) {
              this.player.y = maxY;
              this.player.vy = 0;
              onBoundary = true;
            }
            if (this.player.y <= minY) {
              this.player.y = minY;
              this.player.vy = 0;
            }
          }

          // 4. Object Collisions
          const pBox = { x: this.player.x, y: this.player.y, w: PLAYER_SIZE, h: PLAYER_SIZE };
          let touchingPlatform = false;

          for (const obj of objects) {
            if (Math.abs(obj.x - this.player.x) > 350) continue;

            const isPhaseIntangible = obj.phase && obj.phase !== 'none' && obj.phase !== this.player.phase;
            if (isPhaseIntangible) continue;

            if (obj.type === 'jump_ring' && !obj.activated) {
              const ringCenterX = obj.x + obj.w / 2;
              const ringCenterY = obj.y + obj.h / 2;
              const playerCenterX = this.player.x + pBox.w / 2;
              const playerCenterY = this.player.y + pBox.h / 2;
              const dist = Math.hypot(ringCenterX - playerCenterX, ringCenterY - playerCenterY);

              if (dist <= 52 && (this.player.jumpJustPressed || this.player.jumpBufferTimer > 0)) {
                obj.activated = true;
                if (obj.ringType === 'yellow') {
                  this.player.vy = CUBE_JUMP_IMPULSE * this.player.gravityDir * 1.05;
                } else if (obj.ringType === 'purple') {
                  this.player.vy = CUBE_JUMP_IMPULSE * this.player.gravityDir * 0.85;
                } else if (obj.ringType === 'blue') {
                  this.player.gravityDir = this.player.gravityDir * -1;
                  this.player.vy = CUBE_JUMP_IMPULSE * this.player.gravityDir * 0.85;
                }
                this.player.isGrounded = false;
                this.player.jumpBufferTimer = 0;
                this.score += 150;
                this.combo = Math.min(8, this.combo + 1);
                rhythmAudio.playRingHit();
                this.screenShake = 7;
                this.spawnSparks(ringCenterX, ringCenterY, 18, '#ffaa00');
              }
            } else if (obj.type === 'jump_pad' && !obj.activated) {
              if (checkAABB(pBox, obj)) {
                obj.activated = true;
                if (obj.padType === 'yellow') {
                  this.player.vy = CUBE_JUMP_IMPULSE * 1.35 * this.player.gravityDir;
                } else if (obj.padType === 'pink') {
                  this.player.vy = CUBE_JUMP_IMPULSE * 0.95 * this.player.gravityDir;
                }
                this.player.isGrounded = false;
                this.score += 100;
                rhythmAudio.playJump();
                this.screenShake = 5;
                this.spawnSparks(obj.x + obj.w / 2, obj.y + obj.h / 2, 14, '#00f0ff');
              }
            } else if (
              (obj.type === 'portal_gravity' ||
                obj.type === 'portal_vehicle' ||
                obj.type === 'portal_phase' ||
                obj.type === 'speed_gate') &&
              !obj.activated
            ) {
              if (checkAABB(pBox, obj)) {
                obj.activated = true;
                if (obj.type === 'portal_gravity' && obj.portalGravity) {
                  this.player.gravityDir = obj.portalGravity;
                  rhythmAudio.playGravityFlip();
                } else if (obj.type === 'portal_vehicle' && obj.portalVehicle) {
                  this.player.vehicleMode = obj.portalVehicle;
                  this.player.rotation = 0;
                  rhythmAudio.playJump();
                } else if (obj.type === 'portal_phase' && obj.phase) {
                  this.player.phase = obj.phase;
                  rhythmAudio.playPhaseShift();
                } else if (obj.type === 'speed_gate' && obj.speedMultiplier) {
                  this.player.speedMultiplier = obj.speedMultiplier;
                  rhythmAudio.playRingHit();
                }
                this.score += 200;
                this.screenShake = 8;
                this.spawnSparks(obj.x + obj.w / 2, this.player.y + PLAYER_SIZE / 2, 20, '#00f0ff');
              }
            } else if (obj.type === 'coin' && !obj.activated) {
              if (checkAABB(pBox, obj)) {
                obj.activated = true;
                rhythmAudio.playCoin();
                if (obj.coinIndex !== undefined) {
                  this.coinsCollected[obj.coinIndex] = true;
                }
                this.score += 1000;
                this.combo = Math.min(8, this.combo + 1);
                this.spawnSparks(obj.x + obj.w / 2, obj.y + obj.h / 2, 28, '#ffd700');
              }
            } else if (obj.type === 'spike') {
              if (checkSpikeCollision(pBox, obj)) {
                this.handleCrash();
                return;
              }
            } else if (obj.type === 'block') {
              const col = checkBlockCollision(pBox, obj, this.player.gravityDir);
              if (col === 'side') {
                this.handleCrash();
                return;
              } else if (col === 'top' && this.player.gravityDir === 1) {
                this.player.y = obj.y + obj.h;
                this.player.vy = 0;
                touchingPlatform = true;
              } else if (col === 'bottom' && this.player.gravityDir === -1) {
                this.player.y = obj.y - pBox.h;
                this.player.vy = 0;
                touchingPlatform = true;
              } else if (col === 'head') {
                if (this.player.gravityDir === 1) {
                  this.player.y = obj.y - pBox.h;
                  this.player.vy = 0;
                } else {
                  this.player.y = obj.y + obj.h;
                  this.player.vy = 0;
                }
              }
            }
          }

          this.player.isGrounded = onBoundary || touchingPlatform;

          if (this.player.x >= level.length) {
            this.handleVictory();
            return;
          }
        }
      }

      handleCrash() {
        this.state = 'crashed';
        this.combo = 1;
        rhythmAudio.stopMusic();
        rhythmAudio.playCrash();
        this.screenShake = 18;
        this.spawnDeathBurst(
          this.player.x + PLAYER_SIZE / 2,
          this.player.y + PLAYER_SIZE / 2,
          this.customization.deathVfx
        );
        if (this.onStateChange) this.onStateChange('crashed');
      }

      handleVictory() {
        this.state = 'victory';
        rhythmAudio.stopMusic();
        rhythmAudio.playVictory();
        this.screenShake = 12;
        if (this.onVictory) {
          this.onVictory({
            level: this.currentLevel,
            attempts: this.attempts,
            coins: [...this.coinsCollected],
            time: Math.max(1, this.elapsedTime),
            score: Math.floor(this.score),
          });
        }
        if (this.onStateChange) this.onStateChange('victory');
      }

      // --- Visual Effects & Particle Pool ---
      updateVFX(dt) {
        const targetCamX = this.player.x - 240;
        this.cameraX += (targetCamX - this.cameraX) * Math.min(1.0, 16 * dt);

        if (this.screenShake > 0) {
          this.screenShake = Math.max(0, this.screenShake - 28 * dt);
        }

        if (this.state === 'playing') {
          this.trailNodes.unshift({
            x: this.player.x,
            y: this.player.y,
            rotation: this.player.rotation,
            alpha: 0.9,
          });
          if (this.trailNodes.length > 22) this.trailNodes.pop();

          const trailType = this.customization.trail;
          if (trailType === 'sparkle' && Math.random() < 0.65) {
            this.particles.push({
              x: this.player.x,
              y: this.player.y + PLAYER_SIZE / 2 + (Math.random() - 0.5) * 16,
              vx: -180 - Math.random() * 90,
              vy: (Math.random() - 0.5) * 70,
              size: 3 + Math.random() * 4,
              color: this.customization.primaryColor,
              alpha: 1.0,
              life: 0.35,
              maxLife: 0.35,
            });
          } else if (trailType === 'glitch' && Math.random() < 0.75) {
            this.particles.push({
              x: this.player.x - Math.random() * 10,
              y: this.player.y + Math.random() * PLAYER_SIZE,
              vx: -240,
              vy: 0,
              size: 5 + Math.random() * 6,
              color: Math.random() > 0.5 ? this.customization.primaryColor : '#ff0077',
              alpha: 0.9,
              life: 0.25,
              maxLife: 0.25,
            });
          }
        }

        for (let i = this.particles.length - 1; i >= 0; i--) {
          const p = this.particles[i];
          p.life -= dt;
          if (p.life <= 0) {
            this.particles.splice(i, 1);
            continue;
          }
          p.x += p.vx * dt;
          p.y += p.vy * dt;
          p.alpha = p.life / p.maxLife;
        }

        for (let i = this.shockwaves.length - 1; i >= 0; i--) {
          const sw = this.shockwaves[i];
          sw.life -= dt;
          if (sw.life <= 0) {
            this.shockwaves.splice(i, 1);
            continue;
          }
          sw.radius += sw.speed * dt;
          sw.alpha = sw.life / sw.maxLife;
        }

        for (const node of this.trailNodes) {
          node.alpha -= dt * 3.2;
        }
      }

      spawnSparks(x, y, count, color) {
        for (let i = 0; i < count; i++) {
          const angle = Math.random() * Math.PI * 2;
          const speed = 110 + Math.random() * 240;
          this.particles.push({
            x,
            y,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            size: 3 + Math.random() * 4,
            color,
            alpha: 1.0,
            life: 0.4 + Math.random() * 0.25,
            maxLife: 0.55,
          });
        }
      }

      spawnPhaseShimmerParticles() {
        const col = this.player.phase === 'cyan' ? '#00f0ff' : '#ff0077';
        for (let i = 0; i < 22; i++) {
          this.particles.push({
            x: this.player.x + (Math.random() - 0.5) * 44,
            y: this.player.y + (Math.random() - 0.5) * 44,
            vx: (Math.random() - 0.5) * 220,
            vy: (Math.random() - 0.5) * 220,
            size: 3 + Math.random() * 4,
            color: col,
            alpha: 1.0,
            life: 0.32,
            maxLife: 0.32,
          });
        }
      }

      spawnDeathBurst(x, y, vfxType) {
        const col = this.customization.primaryColor;
        const count = vfxType === 'nova' ? 65 : 42;
        for (let i = 0; i < count; i++) {
          const angle = Math.random() * Math.PI * 2;
          const speed = 150 + Math.random() * 390;
          this.particles.push({
            x,
            y,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            size: vfxType === 'fracture' ? 6 + Math.random() * 6 : 4 + Math.random() * 4,
            color: Math.random() > 0.35 ? col : '#ffffff',
            alpha: 1.0,
            life: 0.6 + Math.random() * 0.3,
            maxLife: 0.75,
          });
        }
        if (vfxType === 'shockwave' || vfxType === 'nova') {
          this.shockwaves.push({ x, y, radius: 10, speed: 460, color: col, alpha: 1.0, life: 0.55, maxLife: 0.55 });
          this.shockwaves.push({ x, y, radius: 4, speed: 290, color: '#ffffff', alpha: 0.9, life: 0.45, maxLife: 0.45 });
        }
      }

      // --- Master Render Pipeline ---
      render() {
        const width = this.container.clientWidth || window.innerWidth;
        const height = this.container.clientHeight || window.innerHeight;

        let shakeX = 0;
        let shakeY = 0;
        if (this.screenShake > 0) {
          shakeX = (Math.random() - 0.5) * this.screenShake;
          shakeY = (Math.random() - 0.5) * this.screenShake;
        }

        this.ctx.save();
        this.ctx.translate(shakeX, shakeY);

        // 1. Upgraded Multi-Layer Cyberpunk Background
        this.renderBackground(width, height);

        const floorScreenY = height - this.currentLevel.floorY;

        this.ctx.save();
        this.ctx.translate(-this.cameraX, floorScreenY);
        this.ctx.scale(1, -1);

        // 2. Render 3D-Style Floor & Ceiling Channels + Runway Markers
        this.renderFloorsAndCeilings(width);

        // 3. Render Level Obstacles & Portals
        this.renderLevelObjects();

        // 4. Render Practice Checkpoints
        if (this.isPracticeMode) {
          this.renderCheckpoints();
        }

        // 5. Render Trails, Shockwaves & Particles
        this.renderParticles();

        // 6. Render Custom Player Vehicle
        if (this.state !== 'crashed') {
          this.renderPlayer();
        }

        this.ctx.restore();

        // 7. Render Screen Vignette, Phase Aura & Crash Prompt
        this.renderScreenVignette(width, height);

        this.ctx.restore();
      }

      // --- UPGRADED MULTI-LAYER CYBERPUNK BACKGROUND ---
      renderBackground(width, height) {
        const ctx = this.ctx;
        const theme = this.currentLevel.theme;
        const floorScreenY = height - this.currentLevel.floorY;
        const ceilScreenY = floorScreenY - this.currentLevel.ceilingY;

        // Beat pulse factor (0.0 to 1.0) synchronized to level BPM
        const bps = this.currentLevel.bpm / 60;
        const beatPhase = (this.bgTime * bps) % 1;
        const beatPulse = Math.pow(1 - beatPhase, 3);

        // LAYER 1: Deep Space Nebula Sky Gradient
        const skyGrad = ctx.createLinearGradient(0, 0, 0, height);
        skyGrad.addColorStop(0, theme.bgGradient[0]);
        skyGrad.addColorStop(0.55, theme.bgGradient[1]);
        skyGrad.addColorStop(1, '#04060b');
        ctx.fillStyle = skyGrad;
        ctx.fillRect(0, 0, width, height);

        // Ambient Phase Nebula Glow
        const phaseCol = this.player.phase === 'cyan' ? 'rgba(0, 240, 255, 0.09)' : 'rgba(255, 0, 119, 0.09)';
        const nebulaGrad = ctx.createRadialGradient(
          width * 0.68,
          height * 0.35,
          20,
          width * 0.68,
          height * 0.35,
          width * 0.55
        );
        nebulaGrad.addColorStop(0, phaseCol);
        nebulaGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx.fillStyle = nebulaGrad;
        ctx.fillRect(0, 0, width, height);

        // LAYER 2: Multi-Depth Twinkling Starfield & Digital Data Motes
        for (const st of this.stars) {
          const sx = ((st.x - this.cameraX * st.speed) % width + width) % width;
          const sy = st.y % Math.max(200, floorScreenY - 40);
          const twinkle = 0.35 + 0.65 * Math.abs(Math.sin(this.bgTime * 2.2 + st.twinklePhase));
          ctx.fillStyle = `rgba(255, 255, 255, ${twinkle * 0.75})`;
          ctx.fillRect(sx, sy, st.size, st.size);
        }

        // LAYER 3: Beat-Reactive Synthwave Sun / Singularity Core
        const sunX = width * 0.72;
        const sunY = Math.max(ceilScreenY + 135, height * 0.34);
        const sunRadius = 74 + beatPulse * 8;

        // Outer Pulse Halo Rings
        ctx.save();
        ctx.strokeStyle = this.player.phase === 'cyan' ? 'rgba(0, 240, 255, 0.22)' : 'rgba(255, 0, 119, 0.22)';
        ctx.lineWidth = 1.5;
        for (let r = 1; r <= 3; r++) {
          ctx.beginPath();
          ctx.arc(sunX, sunY, sunRadius + r * 22 + beatPulse * 10, 0, Math.PI * 2);
          ctx.stroke();
        }

        // Synthwave Sun Disc with Horizontal Scanline Cutouts
        const sunGrad = ctx.createLinearGradient(sunX, sunY - sunRadius, sunX, sunY + sunRadius);
        sunGrad.addColorStop(0, theme.sunColors[0]);
        sunGrad.addColorStop(1, theme.sunColors[1]);
        ctx.fillStyle = sunGrad;
        ctx.beginPath();
        ctx.arc(sunX, sunY, sunRadius, 0, Math.PI * 2);
        ctx.fill();

        // Scanline slices on lower half of sun
        ctx.fillStyle = theme.bgGradient[1];
        for (let sliceY = sunY + 8; sliceY < sunY + sunRadius; sliceY += 11) {
          const sliceH = 2 + ((sliceY - sunY) / sunRadius) * 4.5;
          ctx.fillRect(sunX - sunRadius - 2, sliceY, sunRadius * 2 + 4, sliceH);
        }
        ctx.restore();

        // LAYER 4: Parallax Background Grid (Crisp Cyber Matrix)
        ctx.strokeStyle = theme.gridColor;
        ctx.lineWidth = 1;
        const gridSize = 64;
        const scrollOffset = ((this.cameraX * 0.22) % gridSize + gridSize) % gridSize;
        ctx.beginPath();
        for (let x = -scrollOffset; x < width; x += gridSize) {
          ctx.moveTo(x, Math.max(0, ceilScreenY));
          ctx.lineTo(x, floorScreenY);
        }
        for (let y = Math.max(0, ceilScreenY); y < floorScreenY; y += gridSize) {
          ctx.moveTo(0, y);
          ctx.lineTo(width, y);
        }
        ctx.stroke();

        // LAYER 5: Deterministic World-Space Wireframe Cyber Mountains (0.08x Parallax, Zero Sine Warping!)
        const mtnSpan = 140;
        const mtnParallax = this.cameraX * 0.08;
        const firstMtnIdx = Math.floor(mtnParallax / mtnSpan) - 1;
        const mtnCount = Math.ceil(width / mtnSpan) + 3;

        ctx.save();
        ctx.beginPath();
        ctx.moveTo(0, floorScreenY);
        for (let i = 0; i <= mtnCount; i++) {
          const worldIdx = firstMtnIdx + i;
          const screenX = worldIdx * mtnSpan - mtnParallax;
          // Deterministic pseudo-random mountain peak height from worldIdx
          const hash = Math.abs(Math.sin(worldIdx * 12.9898 + this.currentLevel.id * 4.14) * 43758.5453) % 1;
          const peakH = 85 + hash * 115;
          ctx.lineTo(screenX, floorScreenY - peakH);
        }
        ctx.lineTo(width + mtnSpan, floorScreenY);
        ctx.closePath();
        ctx.fillStyle = theme.mountainColor;
        ctx.fill();
        ctx.strokeStyle = theme.ridgeColor;
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.restore();

        // LAYER 6: Live BPM-Reactive Audio Equalizer Spectrum Behind Megacity Skyline
        const eqSpan = 28;
        const eqCount = Math.ceil(width / eqSpan);
        ctx.save();
        for (let i = 0; i < eqCount; i++) {
          const freqWave = Math.abs(Math.sin(i * 0.45 + this.bgTime * bps * Math.PI));
          const barH = 18 + freqWave * 85 * (0.55 + beatPulse * 0.45);
          ctx.fillStyle = i % 2 === 0 ? 'rgba(0, 240, 255, 0.14)' : 'rgba(255, 0, 119, 0.14)';
          ctx.fillRect(i * eqSpan + 4, floorScreenY - barH, eqSpan - 8, barH);
        }
        ctx.restore();

        // LAYER 7: Deterministic Cyberpunk Megacity Skyline (2 Parallax Tiers with Illuminated Windows!)
        const renderCityTier = (parallaxFactor, bWidth, gap, minH, maxH, fillCol, winCol, seedOffset) => {
          const stepSpan = bWidth + gap;
          const camShift = this.cameraX * parallaxFactor;
          const startIdx = Math.floor(camShift / stepSpan) - 1;
          const count = Math.ceil(width / stepSpan) + 3;

          for (let i = 0; i < count; i++) {
            const bIdx = startIdx + i;
            const bx = bIdx * stepSpan - camShift;
            const h1 = Math.abs(Math.sin((bIdx + seedOffset) * 78.233) * 43758.5453) % 1;
            const h2 = Math.abs(Math.cos((bIdx + seedOffset) * 19.13) * 19341.12) % 1;
            const bh = minH + h1 * (maxH - minH);
            const by = floorScreenY - bh;

            ctx.fillStyle = fillCol;
            ctx.fillRect(bx, by, bWidth, bh);

            // Neon roof trim & antenna spire
            ctx.fillStyle = winCol;
            ctx.fillRect(bx, by, bWidth, 2);
            if (h2 > 0.55) {
              ctx.fillRect(bx + bWidth * 0.5 - 1, by - 18, 2, 18);
            }

            // Lit cyber window matrix
            ctx.fillStyle = winCol;
            const cols = Math.floor((bWidth - 12) / 10);
            const rows = Math.floor((bh - 16) / 14);
            for (let r = 0; r < rows; r++) {
              for (let c = 0; c < cols; c++) {
                const winHash = ((bIdx * 31 + r * 17 + c * 13) & 7);
                if (winHash < 3) {
                  ctx.fillRect(bx + 6 + c * 10, by + 10 + r * 14, 5, 6);
                }
              }
            }
          }
        };

        // Far city tier
        renderCityTier(0.15, 64, 14, 65, 175, 'rgba(6, 10, 20, 0.82)', 'rgba(0, 240, 255, 0.16)', 10);
        // Near city tier
        renderCityTier(0.26, 52, 22, 45, 130, 'rgba(4, 7, 15, 0.92)', 'rgba(255, 0, 119, 0.22)', 77);
      }

      renderFloorsAndCeilings(screenWidth) {
        const ctx = this.ctx;
        const viewLeft = this.cameraX - 100;
        const viewRight = this.cameraX + screenWidth + 200;
        const ceilY = this.currentLevel.ceilingY;

        // Solid Floor Deck & Perspective Grid
        ctx.fillStyle = '#070b14';
        ctx.fillRect(viewLeft, -220, viewRight - viewLeft, 220);

        // Perspective Hash Marks on Floor & Ceiling
        ctx.strokeStyle = 'rgba(0, 240, 255, 0.22)';
        ctx.lineWidth = 1.5;
        const tickStep = 80;
        const firstTick = Math.floor(viewLeft / tickStep) * tickStep;
        ctx.beginPath();
        for (let tx = firstTick; tx < viewRight; tx += tickStep) {
          ctx.moveTo(tx, 0);
          ctx.lineTo(tx - 35, -100);
          ctx.moveTo(tx, ceilY);
          ctx.lineTo(tx - 35, ceilY + 100);
        }
        ctx.stroke();

        // Glowing Floor Horizon Line
        ctx.strokeStyle = this.customization.primaryColor;
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(viewLeft, 0);
        ctx.lineTo(viewRight, 0);
        ctx.stroke();

        // Solid Ceiling Deck
        ctx.fillStyle = '#070b14';
        ctx.fillRect(viewLeft, ceilY, viewRight - viewLeft, 220);

        ctx.strokeStyle = this.customization.primaryColor;
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(viewLeft, ceilY);
        ctx.lineTo(viewRight, ceilY);
        ctx.stroke();

        // Extended Opening Runway Guidance Markers (x = 200 to 1180)
        if (viewLeft < 1220) {
          ctx.save();
          ctx.scale(1, -1);
          ctx.font = 'bold 11px "JetBrains Mono", monospace';
          ctx.fillStyle = 'rgba(0, 240, 255, 0.55)';
          ctx.fillText('>>> RUNWAY SYNC ZONE · PREPARE FOR SECTOR OBSTACLES >>>', 260, 26);
          ctx.fillStyle = 'rgba(255, 170, 0, 0.75)';
          ctx.fillText('▼ COURSE START (1250m)', 1110, 26);
          ctx.restore();
        }
      }

      renderLevelObjects() {
        const ctx = this.ctx;
        const viewLeft = this.cameraX - 100;
        const viewRight = this.cameraX + 1400;

        for (const obj of this.currentLevel.objects) {
          if (obj.x + obj.w < viewLeft || obj.x > viewRight) continue;

          const isPhaseIntangible =
            obj.phase && obj.phase !== 'none' && obj.phase !== this.player.phase;

          ctx.save();
          if (isPhaseIntangible) {
            ctx.globalAlpha = 0.22;
          }

          // 1. Spikes
          if (obj.type === 'spike') {
            const spikeCol =
              obj.phase === 'cyan' ? '#00f0ff' : obj.phase === 'magenta' ? '#ff0077' : '#ff0055';
            ctx.fillStyle = '#10141f';
            ctx.strokeStyle = spikeCol;
            ctx.lineWidth = 2.5;

            ctx.beginPath();
            if (obj.spikeDir === 'down') {
              ctx.moveTo(obj.x, obj.y + obj.h);
              ctx.lineTo(obj.x + obj.w / 2, obj.y);
              ctx.lineTo(obj.x + obj.w, obj.y + obj.h);
            } else {
              ctx.moveTo(obj.x, obj.y);
              ctx.lineTo(obj.x + obj.w / 2, obj.y + obj.h);
              ctx.lineTo(obj.x + obj.w, obj.y);
            }
            ctx.closePath();
            ctx.fill();
            ctx.stroke();
          }

          // 2. Blocks / Phase Platforms & Barriers
          else if (obj.type === 'block') {
            const borderCol =
              obj.phase === 'cyan'
                ? '#00f0ff'
                : obj.phase === 'magenta'
                ? '#ff0077'
                : this.customization.primaryColor;

            ctx.fillStyle = '#0f1422';
            ctx.fillRect(obj.x, obj.y, obj.w, obj.h);

            ctx.strokeStyle = borderCol;
            ctx.lineWidth = 2;
            if (isPhaseIntangible) {
              ctx.setLineDash([6, 4]);
            }
            ctx.strokeRect(obj.x, obj.y, obj.w, obj.h);
            ctx.setLineDash([]);

            ctx.strokeStyle = 'rgba(255, 255, 255, 0.08)';
            ctx.beginPath();
            ctx.moveTo(obj.x, obj.y);
            ctx.lineTo(obj.x + obj.w, obj.y + obj.h);
            ctx.moveTo(obj.x + obj.w, obj.y);
            ctx.lineTo(obj.x, obj.y + obj.h);
            ctx.stroke();
          }

          // 3. Jump Pads
          else if (obj.type === 'jump_pad') {
            const padCol = obj.padType === 'pink' ? '#ff0077' : '#ffaa00';
            ctx.fillStyle = padCol;
            ctx.fillRect(obj.x, obj.y, obj.w, obj.h);
            ctx.strokeStyle = '#ffffff';
            ctx.lineWidth = 2;
            ctx.strokeRect(obj.x, obj.y, obj.w, obj.h);
          }

          // 4. Jump Rings
          else if (obj.type === 'jump_ring') {
            const ringCol =
              obj.ringType === 'blue' ? '#00f0ff' : obj.ringType === 'purple' ? '#a855f7' : '#ffaa00';
            const cx = obj.x + obj.w / 2;
            const cy = obj.y + obj.h / 2;

            ctx.strokeStyle = ringCol;
            ctx.lineWidth = 3.5;
            ctx.beginPath();
            ctx.arc(cx, cy, obj.w / 2, 0, Math.PI * 2);
            ctx.stroke();

            ctx.fillStyle = '#ffffff';
            ctx.beginPath();
            ctx.arc(cx, cy, 5, 0, Math.PI * 2);
            ctx.fill();
          }

          // 5. Portals & Speed Gates
          else if (
            obj.type === 'portal_gravity' ||
            obj.type === 'portal_vehicle' ||
            obj.type === 'portal_phase' ||
            obj.type === 'speed_gate'
          ) {
            let pColor = '#00f0ff';
            let label = 'PORTAL';
            if (obj.type === 'portal_gravity') {
              pColor = obj.portalGravity === -1 ? '#38bdf8' : '#10b981';
              label = obj.portalGravity === -1 ? 'GRAV ▲' : 'GRAV ▼';
            } else if (obj.type === 'portal_vehicle') {
              pColor =
                obj.portalVehicle === 'glider'
                  ? '#ffaa00'
                  : obj.portalVehicle === 'wave'
                  ? '#38bdf8'
                  : '#00ff66';
              label = obj.portalVehicle.toUpperCase();
            } else if (obj.type === 'portal_phase') {
              pColor = obj.phase === 'cyan' ? '#00f0ff' : '#ff0077';
              label = obj.phase === 'cyan' ? 'CYAN' : 'MAGENTA';
            } else if (obj.type === 'speed_gate') {
              pColor = '#10b981';
              label = obj.speedMultiplier > 1 ? 'BOOST >>' : '1.0X >';
            }

            const cx = obj.x + obj.w / 2;
            const cy = obj.y + obj.h / 2;

            // Portal Beam Curtain
            ctx.fillStyle = pColor;
            ctx.globalAlpha = 0.14;
            ctx.fillRect(obj.x + 6, obj.y, obj.w - 12, obj.h);

            // Portal Core Ring
            ctx.globalAlpha = 0.9;
            ctx.strokeStyle = pColor;
            ctx.lineWidth = 3.5;
            ctx.beginPath();
            ctx.ellipse(cx, cy, obj.w / 2, Math.min(95, obj.h / 2.2), 0, 0, Math.PI * 2);
            ctx.stroke();

            // Emitter Caps on Floor & Ceiling
            ctx.fillStyle = pColor;
            ctx.fillRect(obj.x, obj.y, obj.w, 10);
            ctx.fillRect(obj.x, obj.y + obj.h - 10, obj.w, 10);

            // Portal Label Tag
            ctx.save();
            ctx.scale(1, -1);
            ctx.font = 'bold 10px "JetBrains Mono", monospace';
            ctx.fillStyle = '#ffffff';
            ctx.textAlign = 'center';
            ctx.fillText(label, cx, -(cy + 108));
            ctx.restore();
          }

          // 6. Secret Data Coins
          else if (obj.type === 'coin' && !obj.activated) {
            const cx = obj.x + obj.w / 2;
            const cy = obj.y + obj.h / 2;
            ctx.fillStyle = '#ffd700';
            ctx.strokeStyle = '#ffffff';
            ctx.lineWidth = 2;

            ctx.beginPath();
            ctx.arc(cx, cy, 14, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();

            ctx.fillStyle = '#000000';
            ctx.font = 'bold 12px monospace';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.save();
            ctx.scale(1, -1);
            ctx.fillText('★', cx, -cy);
            ctx.restore();
          }

          ctx.restore();
        }
      }

      renderCheckpoints() {
        const ctx = this.ctx;
        for (const cp of this.checkpoints) {
          ctx.fillStyle = '#10b981';
          ctx.strokeStyle = '#ffffff';
          ctx.lineWidth = 2;

          const cx = cp.x + PLAYER_SIZE / 2;
          const cy = cp.y + PLAYER_SIZE / 2;
          ctx.beginPath();
          ctx.moveTo(cx, cy + 12);
          ctx.lineTo(cx + 12, cy);
          ctx.lineTo(cx, cy - 12);
          ctx.lineTo(cx - 12, cy);
          ctx.closePath();
          ctx.fill();
          ctx.stroke();
        }
      }

      renderParticles() {
        const ctx = this.ctx;
        const trail = this.customization.trail;

        // 1. Ghost Afterimage Trail
        if (trail === 'ghost') {
          for (const node of this.trailNodes) {
            if (node.alpha <= 0.05) continue;
            ctx.save();
            ctx.globalAlpha = node.alpha * 0.35;
            ctx.translate(node.x + PLAYER_SIZE / 2, node.y + PLAYER_SIZE / 2);
            ctx.rotate((node.rotation * Math.PI) / 180);
            ctx.fillStyle = this.customization.primaryColor;
            ctx.fillRect(-PLAYER_SIZE / 2, -PLAYER_SIZE / 2, PLAYER_SIZE, PLAYER_SIZE);
            ctx.restore();
          }
        }
        // 2. Plasma Laser Stream Trail
        else if (trail === 'laser' && this.trailNodes.length > 1) {
          ctx.save();
          ctx.strokeStyle = this.customization.primaryColor;
          ctx.lineWidth = 4;
          ctx.beginPath();
          for (let i = 0; i < this.trailNodes.length; i++) {
            const n = this.trailNodes[i];
            const nx = n.x + PLAYER_SIZE / 2;
            const ny = n.y + PLAYER_SIZE / 2 + 6;
            if (i === 0) ctx.moveTo(nx, ny);
            else ctx.lineTo(nx, ny);
          }
          ctx.stroke();

          ctx.strokeStyle = '#ff0077';
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          for (let i = 0; i < this.trailNodes.length; i++) {
            const n = this.trailNodes[i];
            const nx = n.x + PLAYER_SIZE / 2;
            const ny = n.y + PLAYER_SIZE / 2 - 6;
            if (i === 0) ctx.moveTo(nx, ny);
            else ctx.lineTo(nx, ny);
          }
          ctx.stroke();
          ctx.restore();
        }

        // 3. Shockwave Rings (Death VFX)
        for (const sw of this.shockwaves) {
          ctx.save();
          ctx.globalAlpha = Math.max(0, sw.alpha);
          ctx.strokeStyle = sw.color;
          ctx.lineWidth = 3.5;
          ctx.beginPath();
          ctx.arc(sw.x, sw.y, sw.radius, 0, Math.PI * 2);
          ctx.stroke();
          ctx.restore();
        }

        // 4. Active Sparks & Glitch Particles
        for (const p of this.particles) {
          ctx.save();
          ctx.globalAlpha = Math.max(0, p.alpha);
          ctx.fillStyle = p.color;
          ctx.fillRect(p.x - p.size / 2, p.y - p.size / 2, p.size, p.size);
          ctx.restore();
        }
      }

      renderPlayer() {
        const ctx = this.ctx;
        ctx.save();
        const cx = this.player.x + PLAYER_SIZE / 2;
        const cy = this.player.y + PLAYER_SIZE / 2;

        ctx.translate(cx, cy);
        ctx.rotate((this.player.rotation * Math.PI) / 180);

        const primary = this.customization.primaryColor;
        const secondary = this.customization.secondaryColor;
        const phaseGlow = this.player.phase === 'cyan' ? '#00f0ff' : '#ff0077';

        ctx.strokeStyle = phaseGlow;
        ctx.lineWidth = 3.5;
        ctx.shadowColor = phaseGlow;
        ctx.shadowBlur = 12;

        const half = PLAYER_SIZE / 2;

        if (this.player.vehicleMode === 'glider') {
          ctx.fillStyle = secondary;
          ctx.beginPath();
          ctx.moveTo(half, 0);
          ctx.lineTo(-half, half);
          ctx.lineTo(-PLAYER_SIZE / 3, 0);
          ctx.lineTo(-half, -half);
          ctx.closePath();
          ctx.fill();
          ctx.stroke();

          ctx.fillStyle = primary;
          ctx.fillRect(-PLAYER_SIZE / 4, -4, 14, 8);
        } else if (this.player.vehicleMode === 'wave') {
          ctx.fillStyle = primary;
          ctx.beginPath();
          ctx.moveTo(half, 0);
          ctx.lineTo(0, half);
          ctx.lineTo(-half, 0);
          ctx.lineTo(0, -half);
          ctx.closePath();
          ctx.fill();
          ctx.stroke();

          ctx.fillStyle = '#ffffff';
          ctx.beginPath();
          ctx.arc(0, 0, 4, 0, Math.PI * 2);
          ctx.fill();
        } else {
          // Cube mode respects all 6 custom Garage chassis skins!
          const skin = this.customization.vehicle;
          if (skin === 'hex') {
            ctx.fillStyle = secondary;
            ctx.beginPath();
            for (let i = 0; i < 6; i++) {
              const ang = (i * Math.PI) / 3;
              const rx = Math.cos(ang) * half;
              const ry = Math.sin(ang) * half;
              if (i === 0) ctx.moveTo(rx, ry);
              else ctx.lineTo(rx, ry);
            }
            ctx.closePath();
            ctx.fill();
            ctx.stroke();

            ctx.fillStyle = primary;
            ctx.beginPath();
            ctx.arc(0, 0, half * 0.45, 0, Math.PI * 2);
            ctx.fill();
          } else if (skin === 'star') {
            ctx.fillStyle = primary;
            ctx.beginPath();
            for (let i = 0; i < 8; i++) {
              const r = i % 2 === 0 ? half : half * 0.48;
              const ang = (i * Math.PI) / 4;
              const rx = Math.cos(ang) * r;
              const ry = Math.sin(ang) * r;
              if (i === 0) ctx.moveTo(rx, ry);
              else ctx.lineTo(rx, ry);
            }
            ctx.closePath();
            ctx.fill();
            ctx.stroke();

            ctx.fillStyle = '#ffffff';
            ctx.beginPath();
            ctx.arc(0, 0, 5, 0, Math.PI * 2);
            ctx.fill();
          } else if (skin === 'droid') {
            ctx.fillStyle = secondary;
            ctx.fillRect(-half, -half, PLAYER_SIZE, PLAYER_SIZE);
            ctx.strokeRect(-half, -half, PLAYER_SIZE, PLAYER_SIZE);

            // Cyber visor bar
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(-half + 6, 2, PLAYER_SIZE - 12, 8);
            ctx.fillStyle = primary;
            ctx.fillRect(-half + 8, -10, PLAYER_SIZE - 16, 6);
          } else {
            // Standard Core Cube (or Glider/Wave chosen as skin)
            ctx.fillStyle = secondary;
            ctx.fillRect(-half, -half, PLAYER_SIZE, PLAYER_SIZE);
            ctx.strokeRect(-half, -half, PLAYER_SIZE, PLAYER_SIZE);

            ctx.fillStyle = primary;
            ctx.fillRect(-half / 2, -half / 2, half, half);

            ctx.fillStyle = '#ffffff';
            ctx.fillRect(2, -PLAYER_SIZE / 6, 8, PLAYER_SIZE / 3);
          }
        }

        ctx.restore();
      }

      renderScreenVignette(width, height) {
        const ctx = this.ctx;
        if (this.player.isTimeDilated) {
          const grad = ctx.createRadialGradient(
            width / 2,
            height / 2,
            width * 0.25,
            width / 2,
            height / 2,
            width * 0.7
          );
          grad.addColorStop(0, 'rgba(56, 189, 248, 0)');
          grad.addColorStop(1, 'rgba(56, 189, 248, 0.28)');
          ctx.fillStyle = grad;
          ctx.fillRect(0, 0, width, height);
        }

        const borderCol =
          this.player.phase === 'cyan' ? 'rgba(0, 240, 255, 0.14)' : 'rgba(255, 0, 119, 0.14)';
        ctx.strokeStyle = borderCol;
        ctx.lineWidth = 8;
        ctx.strokeRect(0, 0, width, height);

        // Crash Respawn Banner Overlay
        if (this.state === 'crashed') {
          ctx.save();
          ctx.fillStyle = 'rgba(0, 0, 0, 0.55)';
          ctx.fillRect(0, height / 2 - 55, width, 110);
          ctx.strokeStyle = '#ff0055';
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(0, height / 2 - 55);
          ctx.lineTo(width, height / 2 - 55);
          ctx.moveTo(0, height / 2 + 55);
          ctx.lineTo(width, height / 2 + 55);
          ctx.stroke();

          ctx.fillStyle = '#ffffff';
          ctx.font = 'bold 22px "JetBrains Mono", monospace';
          ctx.textAlign = 'center';
          ctx.fillText('SIGNAL DESYNCHRONIZED · HULL FRACTURE', width / 2, height / 2 - 8);

          ctx.fillStyle = '#00f0ff';
          ctx.font = 'bold 13px "JetBrains Mono", monospace';
          ctx.fillText('PRESS [SPACE], [R], OR CLICK TO REDEPLOY (NO AUTO-JUMP)', width / 2, height / 2 + 24);
          ctx.restore();
        }
      }
    }

