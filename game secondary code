          : 'px-3 py-1.5 rounded border font-mono text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 cursor-pointer bg-zinc-900/80 border-amber-500/40 text-amber-300 hover:border-amber-400';
        autoBtn.textContent = t.isAutoplay ? 'AUTOPLAY: ON [A]' : 'AUTOPLAY: OFF [A]';
