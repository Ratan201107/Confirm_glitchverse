        slowBtn.className = t.isTimeDilated
          ? 'px-3 py-1.5 rounded border font-mono text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 cursor-pointer bg-sky-500 text-black border-sky-300 shadow-[0_0_14px_rgba(56,189,248,0.7)]'
