    // =========================================================================
    // 4. PRECISION SUB-STEPPED PHYSICS & AUTOPLAY PILOT ENGINE
    // =========================================================================
    const PLAYER_SIZE = 38;
    const CUBE_GRAVITY = 2100;
    const CUBE_JUMP_IMPULSE = 660;
    const GLIDER_THRUST = 1350;
    const GLIDER_GRAVITY = 1100;
